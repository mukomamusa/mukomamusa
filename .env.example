# Vayazed v2.0.0 Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# SQLite (Development - Already configured)
# DATABASE_URL=./bus_booking.db

# PostgreSQL (Production)
DATABASE_URL=postgresql://username:password@localhost:5432/vayazed

# ===========================================
# AUTHENTICATION
# ===========================================

# JWT Secret (Generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-change-this-in-production

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# PAYMENT GATEWAY - FLUTTERWAVE
# ===========================================

# Get your keys from: https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-your-encryption-key-here

# Payment Mode (test or live)
PAYMENT_MODE=test

# ===========================================
# MOBILE MONEY - ZAMBIA
# ===========================================

# Airtel Money
AIRTEL_MERCHANT_ID=your-airtel-merchant-id
AIRTEL_API_KEY=your-airtel-api-key
AIRTEL_API_SECRET=your-airtel-api-secret

# MTN Mobile Money
MTN_MERCHANT_ID=your-mtn-merchant-id
MTN_API_KEY=your-mtn-api-key
MTN_API_SECRET=your-mtn-api-secret

# ===========================================
# EMAIL SERVICE
# ===========================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Settings
FROM_EMAIL=noreply@vayazed.com
FROM_NAME=Vayazed

# Email Verification (disable in development)
ENABLE_EMAIL_VERIFICATION=false

# ===========================================
# GPS TRACKING PROVIDERS
# ===========================================

# Ctrack
CTRACK_API_KEY=your-ctrack-api-key
CTRACK_API_URL=https://api.ctrack.com

# Tramigo
TRAMIGO_API_KEY=your-tramigo-api-key
TRAMIGO_API_URL=https://api.tramigo.com

# Teltonika
TELTONIKA_API_KEY=your-teltonika-api-key
TELTONIKA_API_URL=https://api.teltonika.com

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# App Name
NEXT_PUBLIC_APP_NAME=Vayazed

# Environment
NODE_ENV=development

# Currency
CURRENCY_CODE=ZMW
CURRENCY_SYMBOL=K

# ===========================================
# PWA CONFIGURATION
# ===========================================

NEXT_PUBLIC_PWA_START_URL=/
NEXT_PUBLIC_PWA_DISPLAY=standalone
NEXT_PUBLIC_PWA_THEME_COLOR=#2BB2A9
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#000103

# ===========================================
# ANALYTICS & MONITORING (Optional)
# ===========================================

# Google Analytics
NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# SECURITY
# ===========================================

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Session Configuration
SESSION_MAX_AGE=86400
SESSION_UPDATE_AGE=3600

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable/disable features
ENABLE_AGENT_SYSTEM=true
ENABLE_REVIEWS=true
ENABLE_REAL_TIME_TRACKING=true
ENABLE_PWA=true
ENABLE_OFFLINE_MODE=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Skip email verification in development
SKIP_EMAIL_VERIFICATION=true

# Enable debug logging
DEBUG=false

# Show detailed errors
SHOW_DETAILED_ERRORS=true

# ===========================================
# FILE UPLOAD
# ===========================================

# Max file size (in bytes)
MAX_FILE_SIZE=5242880

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Upload directory
UPLOAD_DIR=./public/uploads

# ===========================================
# NOTIFICATIONS
# ===========================================

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# SMS Notifications (Africa's Talking)
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_SENDER_ID=VAYAZED

# ===========================================
# REDIS (Optional - for caching/sessions)
# ===========================================

# REDIS_URL=redis://localhost:6379

# ===========================================
# LOGGING
# ===========================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/vayazed.log